#compdef qdrop

autoload -U is-at-least

_qdrop() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_qdrop_commands" \
"*::: :->qdrop" \
&& ret=0
    case $state in
    (qdrop)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:qdrop-command-$line[1]:"
        case $line[1] in
            (pair)
_arguments "${_arguments_options[@]}" : \
'--remove=[Remove an existing pairing by name]:NAME:_default' \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'::target -- Peer name or IP to pair with. Omit to enter discoverable mode (side A):_default' \
&& ret=0
;;
(peers)
_arguments "${_arguments_options[@]}" : \
'--json[Emit JSON instead of a table]' \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
(send)
_arguments "${_arguments_options[@]}" : \
'--to=[Target peer name. Defaults to all paired peers (or the sole peer)]:NAME:_default' \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'*::paths -- Files to send:_files' \
&& ret=0
;;
(open)
_arguments "${_arguments_options[@]}" : \
'--to=[Target peer name]:NAME:_default' \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
':url -- URL to open on the peer:_default' \
&& ret=0
;;
(clip)
_arguments "${_arguments_options[@]}" : \
'--pause[Pause clipboard sync]' \
'--resume[Resume clipboard sync]' \
'--toggle[Flip between paused and active]' \
'--status[Show clipboard sync status (the default)]' \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'--json[Emit the raw JSON from the daemon]' \
'--waybar[Emit a single line of waybar JSON (\`text\` / \`tooltip\` / \`class\`)]' \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
(daemon)
_arguments "${_arguments_options[@]}" : \
'--port=[Override the listen port from config]:PORT:_default' \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_qdrop__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:qdrop-help-command-$line[1]:"
        case $line[1] in
            (pair)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(peers)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(send)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(open)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(clip)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(daemon)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_qdrop_commands] )) ||
_qdrop_commands() {
    local commands; commands=(
'pair:Pair with another device, or manage existing pairings' \
'peers:List paired peers and their status' \
'send:Send one or more files to a peer' \
'open:Open a URL on a peer' \
'clip:Control clipboard synchronization' \
'status:Show live daemon status (peers, clipboard)' \
'daemon:Run the qdrop daemon in the foreground' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'qdrop commands' commands "$@"
}
(( $+functions[_qdrop__subcmd__clip_commands] )) ||
_qdrop__subcmd__clip_commands() {
