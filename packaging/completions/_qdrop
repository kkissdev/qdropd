#compdef qdrop

autoload -U is-at-least

_qdrop() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-q[Suppress progress/status output (errors still print)]' \
'--quiet[Suppress progress/status output (errors still print)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_qdrop_commands" \
"*::: :->qdrop" \
&& ret=0
    case $state in
    (qdrop)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:qdrop-command-$line[1]:"
        case $line[1] in
            (pair)
_arguments "${_arguments_options[@]}" : \
'--remove=[Remove an existing pairing by name]:NAME:_default' \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-q[Suppress progress/status output (errors still print)]' \
'--quiet[Suppress progress/status output (errors still print)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'::target -- Peer name or IP to pair with. Omit to enter discoverable mode (side A):_default' \
&& ret=0
;;
(peers)
_arguments "${_arguments_options[@]}" : \
'--json[Emit JSON instead of a table]' \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-q[Suppress progress/status output (errors still print)]' \
'--quiet[Suppress progress/status output (errors still print)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
(send)
_arguments "${_arguments_options[@]}" : \
'--to=[Target peer name. Defaults to all connected peers]:NAME:_default' \
'--name=[Filename to use for stdin (\`-\`). Default \`stdin-<timestamp>.bin\`]:NAME:_default' \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-q[Suppress progress/status output (errors still print)]' \
'--quiet[Suppress progress/status output (errors still print)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'*::paths -- Files to send. A single `-` reads the file from stdin:_files' \
&& ret=0
;;
(recv)
_arguments "${_arguments_options[@]}" : \
'--timeout=[Give up after this many seconds (default 300)]:SECS:_default' \
'--stdout[Write the file'\''s contents to stdout instead of leaving it on disk]' \
'--keep[With \`--stdout\`, keep the file in the download folder too]' \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-q[Suppress progress/status output (errors still print)]' \
'--quiet[Suppress progress/status output (errors still print)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
(paste)
_arguments "${_arguments_options[@]}" : \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-q[Suppress progress/status output (errors still print)]' \
'--quiet[Suppress progress/status output (errors still print)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
(copy)
_arguments "${_arguments_options[@]}" : \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-q[Suppress progress/status output (errors still print)]' \
'--quiet[Suppress progress/status output (errors still print)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
(open)
_arguments "${_arguments_options[@]}" : \
'--to=[Target peer name]:NAME:_default' \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-q[Suppress progress/status output (errors still print)]' \
'--quiet[Suppress progress/status output (errors still print)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
':url -- URL to open on the peer:_default' \
&& ret=0
;;
(clip)
_arguments "${_arguments_options[@]}" : \
'--restore=[Put history entry N back on the clipboard]:N:_default' \
'--send=[Send history entry N to a peer]:N:_default' \
'--to=[Target peer for \`--send\` (default\: all connected)]:NAME:_default' \
'--pause[Pause clipboard sync]' \
'--resume[Resume clipboard sync]' \
'--toggle[Flip between paused and active]' \
'--status[Show clipboard sync status (the default)]' \
'--history[List recent clipboard entries]' \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-q[Suppress progress/status output (errors still print)]' \
'--quiet[Suppress progress/status output (errors still print)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
(auth)
_arguments "${_arguments_options[@]}" : \
'--remove=[Revoke authorization for this peer]:NAME:_default' \
'--mutual[Also ask the peer to authorize this machine back]' \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-q[Suppress progress/status output (errors still print)]' \
'--quiet[Suppress progress/status output (errors still print)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'::name -- Peer name or device id to authorize (must be paired and connected):_default' \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
'--json[Emit the raw JSON from the daemon]' \
'--waybar[Emit a single line of waybar JSON (\`text\` / \`tooltip\` / \`class\`)]' \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-q[Suppress progress/status output (errors still print)]' \
'--quiet[Suppress progress/status output (errors still print)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
'--json[Emit the checks as JSON]' \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-q[Suppress progress/status output (errors still print)]' \
'--quiet[Suppress progress/status output (errors still print)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
(daemon)
_arguments "${_arguments_options[@]}" : \
'--port=[Override the listen port from config]:PORT:_default' \
'-v[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'--verbose[Increase log verbosity (debug). Overridden by \`RUST_LOG\`]' \
'-q[Suppress progress/status output (errors still print)]' \
'--quiet[Suppress progress/status output (errors still print)]' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_qdrop__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:qdrop-help-command-$line[1]:"
        case $line[1] in
            (pair)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(peers)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(send)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(recv)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(paste)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(copy)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(open)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(clip)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(auth)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(status)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(doctor)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(daemon)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_qdrop_commands] )) ||
_qdrop_commands() {
    local commands; commands=(
'pair:Pair with another device, or manage existing pairings' \
'peers:List paired peers and their status' \
'send:Send one or more files to a peer (use \`-\` for stdin)' \
'recv:Wait for an incoming file; print its path or stream it to stdout' \
'paste:Print a peer'\''s shared clipboard text to stdout' \
'copy:Read stdin and set it as the shared clipboard' \
'open:Open a URL on a peer' \
'clip:Control clipboard synchronization' \
'auth:Pre-authorize a paired peer to send here unattended' \
'status:Show live daemon status (peers, clipboard)' \
'doctor:Diagnose why sync isn'\''t working' \
'daemon:Run the qdrop daemon in the foreground' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'qdrop commands' commands "$@"
}
